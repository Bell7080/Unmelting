{
  "name": "unmelting",
  "version": "3.4.0",
  "description": "A card rain roguelike about an unmelting girl navigating advancing cards",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "resources:check": "tsx src/tools/resource-lifecycle-check.ts",
    "verify": "npm run type-check && npm run lint && npm run test && npm run resources:check",
    "balance:boss": "tsx src/tools/boss-balance-report.ts",
    "ena:pretrain": "tsx src/tools/ena-pretrain-report.ts"
  },
  "dependencies": {
    "howler": "^2.2.4"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}
